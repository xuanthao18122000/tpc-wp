{
  "name": "tinphat-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Theme WordPress cho Tín Phát Construction",
  "scripts": {
    "dev": "npm-run-all --parallel watch:css watch:js",
    "build": "npm-run-all build:css build:js",
    "build:css": "tailwindcss -i assets/src/css/main.css -o assets/dist/main.css --minify",
    "watch:css": "tailwindcss -i assets/src/css/main.css -o assets/dist/main.css --watch",
    "build:js": "esbuild assets/src/js/main.js --bundle --minify --outfile=assets/dist/app.js",
    "watch:js": "esbuild assets/src/js/main.js --bundle --outfile=assets/dist/app.js --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.8"
  },
  "dependencies": {
    "swiper": "^11.2.10"
  }
}
